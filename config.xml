<?xml version='1.0' encoding='utf-8'?>
<widget id="com.cocada.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Cocada Vendas</name>
    <description>App de vendas com GPS e rastreamento de rotas</description>
    <author email="contato@cocadadossonhos.com" href="https://cocadadossonhos.com">Cocada dos Sonhos</author>
    
    <content src="index.html" />
    
    <access origin="*" />
    <allow-navigation href="http://*/*" />
    <allow-navigation href="https://*/*" />
    <allow-navigation href="data:*" />
    
    <!-- Permissões Android -->
    <permission name="android.permission.INTERNET" />
    <permission name="android.permission.ACCESS_FINE_LOCATION" />
    <permission name="android.permission.ACCESS_COARSE_LOCATION" />
    
    <platform name="android">
        <allow-intent href="market:*" />
        <icon src="res/android/icon.png" density="ldpi" />
        <icon src="res/android/icon-96x96.png" density="xhdpi" />
        <icon src="res/android/icon-144x144.png" density="xxhdpi" />
        <splash src="res/android/splash-port-ldpi.png" density="port-ldpi" />
        <splash src="res/android/splash-port-mdpi.png" density="port-mdpi" />
    </platform>
    
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
        <icon src="res/ios/icon.png" width="57" height="57" />
        <icon src="res/ios/icon@2x.png" width="114" height="114" />
    </platform>
    
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="true" />
    <preference name="AndroidLaunchMode" value="singleTop" />
    <preference name="StatusBarBackgroundColor" value="#08140f" />
    <preference name="StatusBarStyle" value="lightcontent" />
    
    <plugin name="cordova-plugin-geolocation" spec="~4.1.0" />
</widget>
